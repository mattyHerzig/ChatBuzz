{
  "name": "chatbuzz",
  "version": "1.0.0",
  "description": "Simple OBS Plugin that displays repeated messages from a Twitch or YouTube chat",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && esbuild src/main.ts --bundle --minify --target=es2019 --outfile=dist/bundle.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "twitch",
    "twitchtv",
    "twitch-tv",
    "obs",
    "obs-studio",
    "twitch-api",
    "youtube",
    "youtube-live"
  ],
  "author": "Matty Herzig",
  "license": "MIT",
  "dependencies": {
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "@types/tmi.js": "^1.8.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
